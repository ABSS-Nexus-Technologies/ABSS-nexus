{
  "name": "abss-nexus-website",
  "version": "1.0.0",
  "private": true,
  "description": "ABSS Nexus Technologies corporate IT services website and admin backend.",
  "scripts": {
    "sync-components": "node scripts/sync-components.js",
    "build": "node scripts/sync-components.js && node scripts/build.js",
    "deploy": "node scripts/sync-components.js && node scripts/build.js && wrangler pages deploy dist",
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "validate": "scripts/validate.sh",
    "test": "scripts/validate.sh",
    "sitemap": "node scripts/build.js",
    "validate-json": "node -e \"JSON.parse(require('fs').readFileSync('./backend/data/db.json')); console.log('JSON is valid');\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@sentry/node": "^11.9.0",
    "razorpay": "^2.9.8",
    "resend": "^6.34.1"
  }
}
