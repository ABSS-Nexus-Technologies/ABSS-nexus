# ========================================================
# ABSS Nexus Technologies - Environment Configuration
# ========================================================

# --------------------------------------------------------
# Admin Authentication (Required in Production)
# --------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-a-strong-secure-password
AUTH_SECRET=generate-a-64-character-random-hex-or-base64-secret

# --------------------------------------------------------
# Cloudflare Turnstile (Optional Bot Protection)
# --------------------------------------------------------
# Obtain these from Cloudflare Dashboard -> Turnstile
# Client-side Site Key (Public):
# TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxxxx
# Server-side Secret Key:
# TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxxxxxxxxxxxx

# --------------------------------------------------------
# Local Development Server (Optional)
# --------------------------------------------------------
PORT=3000

# --------------------------------------------------------
# Transactional Email Gateway (Optional - Resend/SendGrid)
# --------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# SENDER_EMAIL=notifications@abssnexus.in

# --------------------------------------------------------
# Firebase Authentication & Analytics
# --------------------------------------------------------
FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --------------------------------------------------------
# Sentry Error Tracking (Backend & Frontend)
# --------------------------------------------------------
# SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000

# --------------------------------------------------------
# Razorpay Payment Gateway (Test / Live)
# --------------------------------------------------------
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------
# APITXT OTP & SMS Gateway (Optional)
# --------------------------------------------------------
# APITXT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# APITXT_SENDER_ID=ABSSNX


